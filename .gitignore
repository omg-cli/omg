# ============================================
# OMG - Comprehensive .gitignore
# ============================================

# ---- Build outputs ----
/target
/fuzz/target/
dist/
site/dist/
omg-binary

# ---- Cargo ----
# Note: Cargo.lock IS committed (binary project, reproducible builds)
cargo.lock

# ---- Lock files (non-Cargo) ----
# (except the vendored lockfile for SHA-pinned release tooling, which must
# be committed so npm ci verifies integrity of the wrangler dependency tree)
omg.lock
bun.lock
package-lock.json
!.github/deps/release-tools/package-lock.json

# ---- Node / JS ----
node_modules/

# ---- Local secrets and environment overrides ----
.env
.env.*
!.env.example

# ---- Logs and debug output ----
*.log
cargo_tree_*.txt
__pycache__/
*.pyc

# ---- Screenshots and generated images ----
screenshot-*.png

# ---- Dev scripts (organized versions live in scripts/) ----
benchmark_ubuntu.sh
build-pgo.sh
deploy.sh
diag.sh
release.sh
release_and_publish.sh
test_*.sh

# ---- Benchmark scratch (canonical copies live in benchmarks/records/) ----
benchmark_report.md
benchmark_results/
benchmarks/report_*.md

# ---- Editor / IDE / Tool state ----
.windsurf/
.sisyphus/
.ui-design/
.omg/
.vscode/
.idea/
*.swp
*.swo
*~
.wrangler/
.worktrees/

# ---- OS files ----
.DS_Store
Thumbs.db

# ---- Generated documentation ----
# Session artifacts
SESSION-SUMMARY.md
skills.md
MEMORY_AUDIT_REPORT.md
DOCUMENTATION-AUDIT*.md
PERFORMANCE_OPTIMIZATIONS.md

# Research/implementation docs (keep in docs/ only)
ADVANCED_TESTING_STRATEGY.md
ALPM_TEST_DESIGN.md
ALPM_TRANSACTION_TESTING.md
ALPM_TRANSACTION_TESTS_SUMMARY.md
ARCH_E2E_*.md
AUR_E2E_TEST_DESIGN.md
AUR_INSTALL_IMPLEMENTATION.md
AUR_TEST_EXAMPLES.md
AUR_TEST_QUICKSTART.md
BENCHMARK-GUIDE.md
BENCHMARK-RESULTS.md
BENCHMARK_QUICKSTART.md
BUILD_PROFILES.md
CLOUDFLARE_WORKER_*.md
DAEMON_E2E_TEST_DESIGN.md
DEBIAN_PURE_INFO_FIX.md
INSTALLATION-INFRASTRUCTURE.md
PRIVACY.md
SECURITY_TEST*.md
SESSION-SUMMARY.md
S_TIER_E2E_ROADMAP.md
TELEMETRY_*.md
TESTING_*.md

# Site-specific generated docs
site/FIX_TELEMETRY_NOW.md
site/docs/ENTERPRISE_TELEMETRY_RESEARCH.md
site/docs/IMPLEMENTATION_PLAN.md
site/docs/plans/

# ---- Task markers ----
.task7_verified

# ---- Search index ----
pagefind/

# ---- Website split (moved to separate repository) ----
site/
omg-docs/
workers/

# ---- Local orchestration working files ----
tasks/
.opencode/
.tmp/
.pi/verification-evidence/

# ---- Local planning notes (intentionally untracked) ----
TODO-mise-removal.md
.actrc
.github/workflows/.local-*

# ---- Local agent workspaces (never ship review state) ----
.pi/
piolium/

# ---- Audit run artifacts ----
# Dated CI export directories carry guest serial logs, controller logs and
# host runner paths. Ignore only the run directories so the first-class audit
# record (.audit/deep-audit.tsv) stays committable.
/.audit/run-*/
