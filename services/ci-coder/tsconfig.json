{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["workerd"],
    "paths": {
      "#fff": [
        "./node_modules/@opencode/core/dist/types/filesystem/fff.workerd.d.ts"
      ],
      "#persistent-pty-binary": [
        "./node_modules/@opencode/core/dist/types/persistent-pty/binary.workerd.d.ts"
      ]
    },
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "runtime.d.ts"]
}
