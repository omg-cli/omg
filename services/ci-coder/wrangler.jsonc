{
  "name": "omg-ci-coder",
  "account_id": "f1e95b3e1b502cf366dfc81a863695fa",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "minify": true,
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": {
    "bindings": [{ "name": "CODER", "class_name": "Coder" }, { "name": "MODEL_PACER", "class_name": "ModelPacer" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Coder"] }, { "tag": "v2", "new_sqlite_classes": ["ModelPacer"] }],
  "services": [{ "binding": "CI_SERVICE", "service": "omg-cloud-ci" }],
  "vars": {
    "CI_IMAGE_DIGEST": "sha256:768b4ff3432702dbb212ade528445cf8093332593e65657e816c6b0ad85b72a6",
    "CI_VERIFIER_REVISION": "5543893617801998468b71b0e74bf2a18ff93bd3"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "destinations": ["latham-openobserve-logs"],
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "destinations": ["latham-openobserve-traces"],
      "persist": true,
      "head_sampling_rate": 1
    }
  },
}
