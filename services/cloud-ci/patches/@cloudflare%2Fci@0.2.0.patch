+++ b/src/pipeline/persisted-logs.ts
@@ -0,0 +1,161 @@
+import type * as Workers from '@cloudflare/workers-types/index.ts';
+import { createHash } from 'node:crypto';
+import { z } from 'zod';
+import type { CiRunStepOutput } from './types';
+
+declare const FixedLengthStream: typeof Workers.FixedLengthStream;
+
+type StoredLog = string | { r2Key: string };
+export type StoredOutput = Omit<CiRunStepOutput, 'logs'> & {
+  logs: { stdout: StoredLog; stderr: StoredLog };
+};
+
+const storedLogSchema = z.union([z.string(), z.strictObject({ r2Key: z.string() })]);
+const storedOutputSchema = z.strictObject({
+  exitCode: z.number().finite(),
+  logs: z.strictObject({ stdout: storedLogSchema, stderr: storedLogSchema }),
+  logSizes: z.strictObject({
+    stdout: z.number().int().nonnegative(),
+    stderr: z.number().int().nonnegative(),
+  }).optional(),
+  preview: z.strictObject({ stdout: z.string(), stderr: z.string() }).optional(),
+  snapshot: z.strictObject({
+    id: z.string(),
+    dir: z.string(),
+    localBucket: z.boolean().optional(),
+  }),
+  cachePointer: z.strictObject({
+    key: z.string(),
+    createdAt: z.string(),
+    sizeBytes: z.number().int().nonnegative(),
+  }).optional(),
+  cacheHit: z.boolean().optional(),
+});
+
+export function decodeStoredOutput(value: unknown): StoredOutput {
+  return storedOutputSchema.parse(JSON.parse(z.string().parse(value)));
+}
+
+export async function persistLogs<T extends Pick<CiRunStepOutput, "logs" | "logSizes">>(
+  bucket: R2Bucket,
+  prefix: string,
+  output: T
+): Promise<Omit<T, "logs"> & { logs: StoredOutput["logs"] }> {
+  const results = await Promise.allSettled([
+    storeLog(bucket, `${prefix}/stdout`, output.logs.stdout, output.logSizes?.stdout),
+    storeLog(bucket, `${prefix}/stderr`, output.logs.stderr, output.logSizes?.stderr),
+  ]);
+  const [stdout, stderr] = results;
+  if (stdout.status === 'rejected') throw stdout.reason;
+  if (stderr.status === 'rejected') throw stderr.reason;
+  return { ...output, logs: { stdout: stdout.value, stderr: stderr.value } };
+}
+
+async function storeLog(
+  bucket: R2Bucket,
+  r2Key: string,
+  log: CiRunStepOutput['logs']['stdout'],
+  size: number | undefined
+): Promise<StoredLog> {
+  if (typeof log === 'string') return log;
+  if (size === undefined || !Number.isSafeInteger(size) || size < 0) {
+    await log.cancel().catch(() => { console.warn('CI stream cleanup failed'); });
+    throw new Error('Streamed CI log has no valid byte length');
+  }
+  let existing: Workers.R2ObjectBody | null;
+  try {
+    existing = await bucket.get(r2Key);
+  } catch (error) {
+    await log.cancel().catch(() => { console.warn('CI stream cleanup failed'); });
+    throw error;
+  }
+  if (existing) {
+    if (existing.size !== size) {
+      await Promise.allSettled([log.cancel(), existing.body.cancel()]);
+      throw new Error('Existing CI log size differs');
+    }
+    const incomingReader = log.getReader();
+    const existingReader = existing.body.getReader();
+    try {
+      const [incomingHash, existingHash] = await Promise.all([
+        hashLog(incomingReader, size),
+        hashLog(existingReader, size),
+      ]);
+      if (incomingHash !== existingHash) throw new Error('Existing CI log bytes differ');
+      return { r2Key };
+    } finally {
+      await Promise.allSettled([incomingReader.cancel(), existingReader.cancel()]);
+      incomingReader.releaseLock();
+      existingReader.releaseLock();
+    }
+  }
+  const body = new FixedLengthStream(size);
+  const reader = log.getReader();
+  const writer = body.writable.getWriter();
+  const transfer = (async () => {
+    try {
+      for (;;) {
+        const chunk = await reader.read();
+        if (chunk.done) break;
+        await writer.write(chunk.value);
+      }
+      await writer.close();
+    } catch (error) {
+      await writer.abort(error).catch(() => { console.warn('CI stream cleanup failed'); });
+      throw error;
+    } finally {
+      await reader.cancel().catch(() => { console.warn('CI stream cleanup failed'); });
+      writer.releaseLock();
+    }
+  })();
+  const upload = Promise.resolve().then(async () => {
+    const saved = await bucket.put(r2Key, body.readable, {
+      httpMetadata: { contentType: 'application/octet-stream' },
+      onlyIf: { etagDoesNotMatch: '*' },
+    });
+    if (!saved) throw new Error('CI log object already exists');
+    return saved;
+  }).catch(async (error) => {
+    await body.readable.cancel(error).catch(() => { console.warn('CI stream cleanup failed'); });
+    throw error;
+  });
+  const [transferred, uploaded] = await Promise.allSettled([transfer, upload]);
+  if (uploaded.status === 'rejected') throw uploaded.reason;
+  if (transferred.status === 'rejected') throw transferred.reason;
+  return { r2Key };
+}
+
+async function hashLog(reader: Pick<Workers.ReadableStreamDefaultReader<Uint8Array>, 'read'>, size: number): Promise<string> {
+  const hash = createHash('sha256');
+  let bytes = 0;
+  for (;;) {
+    const chunk = await reader.read();
+    if (chunk.done) break;
+    bytes += chunk.value.byteLength;
+    if (bytes > size) throw new Error('CI log stream exceeds its byte length');
+    hash.update(chunk.value);
+  }
+  if (bytes !== size) throw new Error('CI log stream ended before its byte length');
+  return hash.digest('hex');
+}
+
+export async function restoreLogs(
+  bucket: R2Bucket,
+  output: StoredOutput
+): Promise<CiRunStepOutput> {
+  const stdout = await loadLog(bucket, output.logs.stdout);
+  try {
+    const stderr = await loadLog(bucket, output.logs.stderr);
+    return { ...output, logs: { stdout, stderr } };
+  } catch (error) {
+    if (typeof stdout !== 'string') await stdout.cancel().catch(() => { console.warn('CI stream cleanup failed'); });
+    throw error;
+  }
+}
+
+async function loadLog(bucket: R2Bucket, log: StoredLog) {
+  if (typeof log === 'string') return log;
+  const object = await bucket.get(log.r2Key);
+  if (!object) throw new Error('Persisted CI log is missing');
+  return object.body;
+}
