+export function rpcData<T>(value: T): T {
+  try {
+    return structuredClone(value);
+  } finally {
+    if (typeof value === 'object' && value !== null && Symbol.dispose in value) {
+      const dispose = value[Symbol.dispose];
+      if (typeof dispose === 'function') dispose.call(value);
+    }
+  }
+}
