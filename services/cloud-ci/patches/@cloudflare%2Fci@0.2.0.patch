+import type * as Workers from "@cloudflare/workers-types/index.ts";
+import type { CiRunStepInput } from "./types";
+import type { StoredOutput } from "./persisted-logs";
+import { createRunnerId } from "../ci/runners/runner-id";
+
+declare const crypto: Crypto & { DigestStream: typeof Workers.DigestStream };
+const objectSchema = z.strictObject({
+  key: z.string(),
+  size: z.number().int().nonnegative(),
+  etag: z.string(),
+  sha256: z
+    .string()
+    .regex(/^[a-f0-9]{64}$/)
+    .optional(),
+});
+const outputSchema = z.strictObject({
+  exitCode: z.literal(0),
+  logs: z.strictObject({
+    stdout: z.strictObject({ r2Key: z.string() }),
+    stderr: z.strictObject({ r2Key: z.string() }),
+  }),
+  logSizes: z.strictObject({
+    stdout: z.number().int().nonnegative(),
+    stderr: z.number().int().nonnegative(),
+  }),
+  snapshot: z.strictObject({
+    id: z.string().uuid(),
+    dir: z.literal("/workspace"),
+    localBucket: z.boolean().optional(),
+  }),
+});
+const receiptSchema = z.strictObject({
+  version: z.literal(2),
+  deadlineMs: z.number().finite().positive(),
+  identity: z.string(),
+  output: outputSchema,
+  objects: z.array(objectSchema).length(4),
+});
+const runningProcessSchema = z.strictObject({
+  physicalRunnerId: z.string().regex(/^ci1-[fc]-[a-f0-9]{56}$/),
+  id: z.string().min(1).max(256),
+  startedAt: z.string().datetime(),
+  commandSha256: z.string().regex(/^[a-f0-9]{64}$/),
+  deadlineMs: z.number().finite().positive(),
+  localBucket: z.boolean(),
+});
+const executionIdentity = {
+  version: z.literal(1),
+  identity: z.string().regex(/^[a-f0-9]{64}$/),
+  deadlineMs: z.number().finite().positive(),
+  recoveryClaimed: z.boolean(),
+};
+const executionSchema = z.discriminatedUnion('state', [
+  z.strictObject({ ...executionIdentity, state: z.literal('preparing') }),
+  z.strictObject({ ...executionIdentity, state: z.literal('started'), process: runningProcessSchema }),
+]);
+export type RunningProcess = z.infer<typeof runningProcessSchema>;
+export type ProcessJournal = {
+  started(process: RunningProcess): Promise<void>;
+  claimRecovery(): Promise<boolean>;
+};
+export class CompletionUnavailableError extends Error {}
+const hex = (bytes: ArrayBuffer) =>
+  Array.from(new Uint8Array(bytes), (value) => value.toString(16).padStart(2, "0")).join("");
+export async function executionHash(value: string) {
+  return hex(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(value)));
+}
+async function identity(input: CiRunStepInput) {
+  return executionHash(JSON.stringify(input));
+}
+const processKey = async (input: CiRunStepInput) => `native-processes/${await createRunnerId(input)}.json`;
+
+export async function beginExecution(bucket: R2Bucket, input: CiRunStepInput) {
+  if (await bucket.head(`native-completions/${await createRunnerId(input)}.json`))
+    return recoverCompletion(bucket, input);
+  const record = executionSchema.parse({
+    version: 1, state: 'preparing', identity: await identity(input),
+    deadlineMs: input.deadlineMs, recoveryClaimed: false,
+  });
+  if (Date.now() >= record.deadlineMs) throw new Error('Running process deadline expired');
+  const saved = await bucket.put(await processKey(input), JSON.stringify(record), {
+    onlyIf: { etagDoesNotMatch: '*' }, httpMetadata: { contentType: 'application/json' },
+  });
+  if (!saved) throw new Error('Running process execution already admitted');
+  return null;
+}
+
+export async function readProcessAdmission(bucket: R2Bucket, input: CiRunStepInput, restoreDeadline = false) {
+  if (restoreDeadline && (input.deadlineMs !== undefined || input.attempt !== 1))
+    throw new Error('Running process replay identity invalid');
+  const object = await bucket.get(await processKey(input));
+  if (!object || object.size > 8192) throw new Error('Running process admission unavailable');
+  const record = executionSchema.parse(await object.json());
+  const captured = restoreDeadline ? { ...input, deadlineMs: record.deadlineMs } : input;
+  if (captured.deadlineMs !== record.deadlineMs || Date.now() >= record.deadlineMs)
+    throw new Error('Running process deadline expired');
+  if (record.identity !== await identity(captured)) throw new Error('Running process identity mismatch');
+  if (record.state === 'started') {
+    const allowed = await Promise.all([createRunnerId(captured), createRunnerId({ ...captured, incarnation: 1 })]);
+    if (!allowed.includes(record.process.physicalRunnerId)) throw new Error('Running process actor identity mismatch');
+    if (record.process.deadlineMs > record.deadlineMs || Date.now() >= record.process.deadlineMs)
+      throw new Error('Running process deadline expired');
+  }
+  return { input: captured, record, etag: object.etag };
+}
+
+export async function recordStartedProcess(bucket: R2Bucket, input: CiRunStepInput, process: RunningProcess) {
+  const prior = await readProcessAdmission(bucket, input);
+  if (prior.record.state !== 'preparing') throw new Error('Running process admission already started');
+  const record = executionSchema.parse({ ...prior.record, state: 'started', process });
+  if (record.state !== 'started') throw new Error('Running process admission is not started');
+  const allowed = await Promise.all([createRunnerId(input), createRunnerId({ ...input, incarnation: 1 })]);
+  if (!allowed.includes(record.process.physicalRunnerId) || record.process.deadlineMs > record.deadlineMs)
+    throw new Error('Running process admission identity invalid');
+  if (!await bucket.put(await processKey(input), JSON.stringify(record), {
+    onlyIf: { etagMatches: prior.etag }, httpMetadata: { contentType: 'application/json' },
+  })) throw new Error('Running process admission changed');
+}
+
+export async function claimProcessRecovery(bucket: R2Bucket, input: CiRunStepInput) {
+  const prior = await readProcessAdmission(bucket, input);
+  if (prior.record.recoveryClaimed) return false;
+  return Boolean(await bucket.put(await processKey(input), JSON.stringify({ ...prior.record, recoveryClaimed: true }), {
+    onlyIf: { etagMatches: prior.etag }, httpMetadata: { contentType: 'application/json' },
+  }));
+}
+
+export async function discardProcessAdmission(bucket: R2Bucket, input: CiRunStepInput) {
+  await bucket.delete(await processKey(input));
+}
+async function fingerprint(bucket: R2Bucket, key: string) {
+  if (key.endsWith("/data.sqsh")) {
+    const object = await bucket.head(key);
+    if (!object) throw new Error("Completed runner snapshot is missing");
+    return { key, size: object.size, etag: object.etag };
+  }
+  const object = await bucket.get(key);
+  if (!object) throw new Error("Completed runner object is missing");
+  const hash = new crypto.DigestStream("SHA-256");
+  await object.body.pipeTo(hash);
+  return { key, size: object.size, etag: object.etag, sha256: hex(await hash.digest) };
+}
+async function keys(output: z.infer<typeof outputSchema>, input: CiRunStepInput) {
+  const prefix = `logs/${input.instanceId}/native/${await createRunnerId(input)}`;
+  for (const channel of ["stdout", "stderr"] as const) {
+    if (output.logs[channel].r2Key !== `${prefix}/${channel}`)
+      throw new Error("Completed runner log identity mismatch");
+  }
+  return [
+    output.logs.stdout.r2Key,
+    output.logs.stderr.r2Key,
+    `backups/${output.snapshot.id}/meta.json`,
+    `backups/${output.snapshot.id}/data.sqsh`,
+  ];
+}
+async function validate(bucket: R2Bucket, input: CiRunStepInput, value: unknown) {
+  const receipt = receiptSchema.parse(value);
+  if (receipt.identity !== (await identity(input)))
+    throw new Error("Completed runner identity mismatch");
+  const expected = await keys(receipt.output, input);
+  for (const [index, key] of expected.entries()) {
+    const object = receipt.objects[index];
+    if (object.key !== key) throw new Error("Completed runner object identity mismatch");
+    const actual = await fingerprint(bucket, key);
+    if (
+      actual.size !== object.size ||
+      actual.etag !== object.etag ||
+      actual.sha256 !== object.sha256
+    )
+      throw new Error("Completed runner object integrity mismatch");
+    if (index < 2 && actual.size !== receipt.output.logSizes[index === 0 ? "stdout" : "stderr"])
+      throw new Error("Completed runner log size mismatch");
+  }
+  return receipt.output;
+}
+export async function persistCompletion(
+  bucket: R2Bucket,
+  input: CiRunStepInput,
+  value: StoredOutput,
+) {
+  const output = outputSchema.parse({
+    exitCode: value.exitCode,
+    logs: value.logs,
+    logSizes: value.logSizes,
+    snapshot: value.snapshot,
+  });
+  const objects = await Promise.all(
+    (await keys(output, input)).map((key) => fingerprint(bucket, key)),
+  );
+  const receipt = receiptSchema.parse({
+    version: 2,
+    deadlineMs: input.deadlineMs,
+    identity: await identity(input),
+    output,
+    objects,
+  });
+  const key = `native-completions/${await createRunnerId(input)}.json`;
+  const saved = await bucket.put(key, JSON.stringify(receipt), {
+    onlyIf: { etagDoesNotMatch: "*" },
+    httpMetadata: { contentType: "application/json" },
+  });
+  if (!saved) {
+    const previous = await bucket.get(key);
+    if (
+      !previous ||
+      previous.size > 16384 ||
+      JSON.stringify(receiptSchema.parse(await previous.json())) !== JSON.stringify(receipt)
+    )
+      throw new Error("Completed runner receipt collision");
+  }
+}
+export async function recoverCompletion(
+  bucket: R2Bucket,
+  input: CiRunStepInput,
+  restoreDeadline = false,
+) {
+  if (restoreDeadline && (input.deadlineMs !== undefined || input.attempt !== 1))
+    throw new Error("Completed runner replay identity invalid");
+  if (
+    !restoreDeadline && (
+      input.deadlineMs === undefined ||
+      !Number.isFinite(input.deadlineMs) ||
+      Date.now() >= input.deadlineMs
+    )
+  )
+    throw new Error("Completed runner deadline expired");
+  const object = await bucket.get(`native-completions/${await createRunnerId(input)}.json`);
+  if (!object) throw new CompletionUnavailableError("Completed runner receipt unavailable");
+  if (object.size > 16384) throw new Error("Completed runner receipt exceeds byte budget");
+  const receipt = receiptSchema.parse(await object.json());
+  const captured = restoreDeadline ? { ...input, deadlineMs: receipt.deadlineMs } : input;
+  if (captured.deadlineMs !== receipt.deadlineMs || Date.now() >= receipt.deadlineMs)
+    throw new Error("Completed runner deadline expired");
+  const output = await validate(bucket, captured, receipt);
+  if (Date.now() >= receipt.deadlineMs) throw new Error("Completed runner deadline expired");
+  return output;
+}
