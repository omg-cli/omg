diff --git a/src/pipeline/operation-interrupted.ts b/src/pipeline/operation-interrupted.ts
new file mode 100644
--- /dev/null
+++ b/src/pipeline/operation-interrupted.ts
@@ -0,0 +1,82 @@
+export type OperationInterruptedTag = 'runtime_replaced' | 'transport_disposed';
+
+export type OperationInterruptedSignal = {
+  readonly kind: 'operation-interrupted';
+  readonly reason: OperationInterruptedTag;
+};
+
+export class CiOperationInterruptedError extends Error {
+  readonly reason: OperationInterruptedTag;
+
+  constructor(reason: OperationInterruptedTag) {
+    super(`CI operation interrupted: ${operationInterruptedTag(reason)}`);
+    this.name = 'CiOperationInterruptedError';
+    this.reason = reason;
+  }
+}
+
+export function operationInterruptedTag(value: unknown): OperationInterruptedTag {
+  if (value === 'runtime_replaced' || value === 'transport_disposed') {
+    return value;
+  }
+  throw new Error('Unknown CI operation interruption reason');
+}
+
+export function encodeOperationInterrupted(
+  error: unknown
+): OperationInterruptedSignal {
+  if (!(error instanceof CiOperationInterruptedError)) throw error;
+  return Object.freeze({
+    kind: 'operation-interrupted',
+    reason: operationInterruptedTag(error.reason),
+  });
+}
+
+export function isOperationInterruptedSignal(
+  value: unknown
+): value is OperationInterruptedSignal {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    !Array.isArray(value) &&
+    Object.hasOwn(value, 'kind') &&
+    (value as { kind?: unknown }).kind === 'operation-interrupted'
+  );
+}
+
+export function decodeOperationInterrupted(
+  signal: OperationInterruptedSignal
+): CiOperationInterruptedError {
+  return new CiOperationInterruptedError(operationInterruptedTag(signal.reason));
+}
+
+export function operationInterruptedFrom(
+  error: unknown
+): CiOperationInterruptedError | undefined {
+  if (!(error instanceof Error)) return undefined;
+  const response = own(error, 'errorResponse');
+  if (!isRecord(response)) return undefined;
+  if (own(response, 'code') !== 'OPERATION_INTERRUPTED') return undefined;
+  const context = own(response, 'context');
+  if (!isRecord(context)) return undefined;
+  if (own(context, 'retryable') !== true) return undefined;
+  const reason = own(context, 'reason');
+  if (reason !== 'runtime_replaced' && reason !== 'transport_disposed') return undefined;
+  const operation = own(context, 'operation');
+  const phase = own(context, 'phase');
+  if (typeof operation !== 'string' || operation.length === 0) return undefined;
+  if (typeof phase !== 'string' || phase.length === 0) return undefined;
+  const admitted = own(context, 'admitted');
+  if (admitted !== true && admitted !== false && admitted !== 'unknown') return undefined;
+  return new CiOperationInterruptedError(reason);
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function own(value: object, key: string): unknown {
+  return Object.hasOwn(value, key)
+    ? (value as Record<string, unknown>)[key]
+    : undefined;
+}
