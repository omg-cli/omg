+async function waitForProcessExit(
+  sandbox: ReturnType<typeof getSandbox>,
+  id: string,
+  timeoutMs: number,
+): Promise<number> {
+  const deadline = Date.now() + timeoutMs;
+  const timedOut = () => new Error('CI process completion timed out');
+  for (;;) {
+    const remaining = deadline - Date.now();
+    if (remaining <= 0) throw timedOut();
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const process = await Promise.race([
+      sandbox.getProcess(id).then(process => {
+        try {
+          return process ? { id: process.id, status: process.status, exitCode: process.exitCode } : null;
+        } finally {
+          if (process && Symbol.dispose in process) {
+            const dispose = process[Symbol.dispose];
+            if (typeof dispose === 'function') dispose.call(process);
+          }
+        }
+      }),
+      new Promise<never>((_, reject) => {
+        timer = setTimeout(() => reject(timedOut()), remaining);
+      }),
+    ]).finally(() => clearTimeout(timer));
+    if (Date.now() > deadline) throw timedOut();
+    if (process) {
+      if (process.id !== id) throw new Error(`CI process identity unavailable (expected ${typeof id}, received ${typeof process.id})`);
+      const { status, exitCode } = process;
+      if (status !== 'starting' && status !== 'running') {
+        if (!['completed', 'failed', 'killed', 'error'].includes(status)) {
+          throw new Error('CI process returned an unknown state');
+        }
+        if (typeof exitCode !== 'number' || !Number.isSafeInteger(exitCode) || exitCode < 0 ||
+            (exitCode === 0 && status !== 'completed')) {
+          throw new Error('CI process terminal exit code unavailable');
+        }
+        return exitCode;
+      }
+    }
+    await new Promise(resolve => setTimeout(resolve, Math.min(1000, Math.max(0, deadline - Date.now()))));
+  }
+}
