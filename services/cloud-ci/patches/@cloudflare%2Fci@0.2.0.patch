+// Copyright (c) 2026 Cloudflare, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+export const MAX_RUNNER_CAUSE = 1024;
+export const RUNNER_CAUSE_OMITTED = '[cause omitted: exceeds safe bound]';
+const MAX_RAW_CAUSE = 65_536;
+const MAX_LABEL = 128;
+const MAX_FIELD = 64;
+const MAX_DEPTH = 4;
+const OWNER = /^cl-([1-9][0-9]{0,19})-([1-9][0-9]{0,5})-([a-f0-9]{40})(?:-(v|ta)-([a-f0-9]{16}))?$/;
+const TOKEN = /^[A-Za-z0-9._-]{1,64}$/;
+
+export type RunnerFailureIdentityInput = {
+  readonly runnerId: string;
+  readonly actor: string;
+  readonly label: string;
+  readonly diagnosticRunId?: string;
+  readonly leaf?: string;
+};
+export type RunnerFailureOwner = {
+  readonly run: string;
+  readonly attempt: string;
+  readonly source: string;
+  readonly variant?: string;
+};
+export type RunnerFailureIdentity = {
+  readonly label: string;
+  readonly runnerId: string;
+  readonly actor: string;
+  readonly owner?: RunnerFailureOwner;
+  readonly leaf?: string;
+  readonly phase?: string;
+};
+export type RunnerFailureEvidence = {
+  readonly identity: RunnerFailureIdentity;
+  readonly cause: string;
+  readonly interruption: boolean;
+  readonly reason?: 'runtime_replaced' | 'transport_disposed';
+  readonly operation?: string;
+  readonly admitted?: true | false | 'unknown';
+  readonly retryable?: boolean;
+};
+type Interruption = {
+  readonly reason: 'runtime_replaced' | 'transport_disposed';
+  readonly operation: string;
+  readonly phase: string;
+  readonly admitted: true | false | 'unknown';
+  readonly retryable: boolean;
+};
+
+const EVIDENCE = new WeakMap<object, RunnerFailureEvidence>();
+
+export function captureRunnerFailure(error: unknown, identity: RunnerFailureIdentityInput): unknown {
+  if (typeof error !== 'object' || error === null) return error;
+  if (EVIDENCE.has(error)) return error;
+  let evidence: RunnerFailureEvidence;
+  try {
+    evidence = buildEvidence(error, identity);
+  } catch {
+    evidence = fallbackEvidence(error, identity);
+  }
+  EVIDENCE.set(error, evidence);
+  return error;
+}
+
+export function runnerFailureOf(error: unknown): RunnerFailureEvidence | undefined {
+  return typeof error === 'object' && error !== null ? EVIDENCE.get(error) : undefined;
+}
+
+export function boundedCause(cause: string, redact: (value: string) => string): string {
+  return redact(cause).slice(0, MAX_RUNNER_CAUSE);
+}
+
+function buildEvidence(error: object, input: RunnerFailureIdentityInput): RunnerFailureEvidence {
+  const interruption = interruptionOf(error);
+  const owner = ownerOf(input.diagnosticRunId);
+  const leaf = tokenOf(input.leaf);
+  return Object.freeze({
+    identity: Object.freeze({
+      label: boundedText(input.label, MAX_LABEL),
+      runnerId: boundedText(input.runnerId, MAX_LABEL),
+      actor: boundedText(input.actor, MAX_LABEL),
+      ...(owner ? { owner } : {}),
+      ...(leaf ? { leaf } : {}),
+      ...(interruption ? { phase: interruption.phase } : {}),
+    }),
+    cause: causeChain(error),
+    interruption: interruption !== undefined,
+    ...(interruption
+      ? {
+          reason: interruption.reason,
+          operation: interruption.operation,
+          admitted: interruption.admitted,
+          retryable: interruption.retryable,
+        }
+      : {}),
+  });
+}
+
+function fallbackEvidence(error: object, input: RunnerFailureIdentityInput): RunnerFailureEvidence {
+  const owner = ownerOf(input.diagnosticRunId);
+  const leaf = tokenOf(input.leaf);
+  const message = readOwn(error, 'message');
+  return Object.freeze({
+    identity: Object.freeze({
+      label: boundedText(input.label, MAX_LABEL),
+      runnerId: boundedText(input.runnerId, MAX_LABEL),
+      actor: boundedText(input.actor, MAX_LABEL),
+      ...(owner ? { owner } : {}),
+      ...(leaf ? { leaf } : {}),
+    }),
+    cause: typeof message === 'string' ? message : '',
+    interruption: false,
+  });
+}
+
+function causeChain(error: object): string {
+  const parts: string[] = [];
+  const seen = new Set<object>();
+  let total = 0;
+  let current = readOwn(error, 'cause');
+  for (let depth = 0; depth < MAX_DEPTH; depth += 1) {
+    if (typeof current !== 'object' || current === null || seen.has(current)) break;
+    seen.add(current);
+    const message = readOwn(current, 'message');
+    if (typeof message === 'string' && message.length > 0 && !parts.includes(message)) {
+      parts.push(message);
+      total += message.length;
+    }
+    if (total > MAX_RAW_CAUSE) return RUNNER_CAUSE_OMITTED;
+    current = readOwn(current, 'cause');
+  }
+  return parts.join(' <- ');
+}
+
+function interruptionOf(error: object): Interruption | undefined {
+  const response = readOwn(error, 'errorResponse');
+  if (!isRecord(response)) return undefined;
+  if (readOwn(response, 'code') !== 'OPERATION_INTERRUPTED') return undefined;
+  return interruptionContext(readOwn(response, 'context'));
+}
+
+function interruptionContext(value: unknown): Interruption | undefined {
+  if (!isRecord(value)) return undefined;
+  const reason = readOwn(value, 'reason');
+  const operation = readOwn(value, 'operation');
+  const phase = readOwn(value, 'phase');
+  const admitted = readOwn(value, 'admitted');
+  const retryable = readOwn(value, 'retryable');
+  if (reason !== 'runtime_replaced' && reason !== 'transport_disposed') return undefined;
+  if (typeof operation !== 'string' || operation.length === 0 || operation.length > MAX_FIELD) {
+    return undefined;
+  }
+  if (typeof phase !== 'string' || phase.length === 0 || phase.length > MAX_FIELD) {
+    return undefined;
+  }
+  if (admitted !== true && admitted !== false && admitted !== 'unknown') return undefined;
+  if (retryable !== true && retryable !== false) return undefined;
+  return Object.freeze({
+    reason,
+    operation,
+    phase,
+    admitted,
+    retryable,
+  });
+}
+
+function ownerOf(value: unknown): RunnerFailureOwner | undefined {
+  if (typeof value !== 'string') return undefined;
+  const match = OWNER.exec(value);
+  if (!match) return undefined;
+  const run = match[1];
+  const attempt = match[2];
+  const source = match[3];
+  if (!run || !attempt || !source) return undefined;
+  const kind = match[4];
+  const id = match[5];
+  return Object.freeze({
+    run,
+    attempt,
+    source,
+    ...(kind && id ? { variant: `${kind}-${id}` } : {}),
+  });
+}
+
+function tokenOf(value: unknown): string | undefined {
+  return typeof value === 'string' && TOKEN.test(value) ? value : undefined;
+}
+
+function boundedText(value: unknown, max: number): string {
+  return typeof value === 'string' ? value.slice(0, max) : '';
+}
+
+function readOwn(value: object, key: string): unknown {
+  try {
+    const descriptor = Object.getOwnPropertyDescriptor(value, key);
+    return descriptor && 'value' in descriptor ? descriptor.value : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
