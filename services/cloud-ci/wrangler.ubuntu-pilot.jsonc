{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omg-cloud-ci-capability-pilot",
  "account_id": "f1e95b3e1b502cf366dfc81a863695fa",
  "main": "src/ubuntu-pilot.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "containers": [{
    "name": "omg-cloud-ci-capability-pilot",
    "class_name": "UbuntuPilotSandbox",
    "image": "registry.cloudflare.com/f1e95b3e1b502cf366dfc81a863695fa/omg-cloud-ci-ubuntu-pilot@sha256:1e1e3805ab6e1b742c19bd8e4a10eb62a1933ba2b7cd6ccdcaa4d2c19abb7a77",
    "max_instances": 1,
    "instance_type": "standard-4"
  }],
  "durable_objects": { "bindings": [{ "name": "PILOT_SANDBOX", "class_name": "UbuntuPilotSandbox" }] },
  "exports": { "UbuntuPilotSandbox": { "type": "durable-object", "storage": "sqlite" } },
  "vars": { "SANDBOX_LOG_LEVEL": "error" },
  "observability": { "enabled": true }
}
