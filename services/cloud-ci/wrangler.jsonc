{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omg-cloud-ci",
  "account_id": "f1e95b3e1b502cf366dfc81a863695fa",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "omg-ci" }],
  "containers": [
    {
      "class_name": "CiSandbox",
      "image": "registry.cloudflare.com/f1e95b3e1b502cf366dfc81a863695fa/omg-cloud-ci@sha256:7d7c8bc89570da1e1234a3596758db6d3d046ba969eccc56ea1e9937166f47a3",
      "max_instances": 2,
      "instance_type": "standard-4",
      "rollout_step_percentage": 100,
    },
  ],
  "durable_objects": { "bindings": [{ "name": "SANDBOX", "class_name": "CiSandbox" }] },
  "exports": { "CiSandbox": { "type": "durable-object", "storage": "sqlite" } },
  "workflows": [{ "name": "omg-cloud-ci", "binding": "CI_WORKFLOW", "class_name": "CI" }],
  "r2_buckets": [{ "binding": "BACKUP_BUCKET", "bucket_name": "omg-ci-private" }],
  "vars": {
    "CI_VERIFIER_REVISION": "2d4a40a4590111fd6b7c9c94bd0ff80479959a2a",
    "CI_IMAGE_DIGEST": "sha256:7d7c8bc89570da1e1234a3596758db6d3d046ba969eccc56ea1e9937166f47a3",
    "BACKUP_BUCKET_NAME": "omg-ci-private",
    "CLOUDFLARE_ACCOUNT_ID": "f1e95b3e1b502cf366dfc81a863695fa",
  },
  "observability": { "enabled": false },
}
