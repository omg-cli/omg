{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omg-cloud-ci",
  "account_id": "f1e95b3e1b502cf366dfc81a863695fa",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "omg-ci" }],
  "containers": [
    {
      "class_name": "CiSandbox",
      "image": "registry.cloudflare.com/f1e95b3e1b502cf366dfc81a863695fa/omg-cloud-ci@sha256:4be14b97d737a2a0ed3b6df9cd34e38623bbd9bd8f2f95d4287e1a9be9253d35",
      "max_instances": 2,
      "instance_type": "standard-4",
      "rollout_step_percentage": 100,
    },
  ],
  "durable_objects": { "bindings": [{ "name": "SANDBOX", "class_name": "CiSandbox" }] },
  "exports": { "CiSandbox": { "type": "durable-object", "storage": "sqlite" } },
  "workflows": [{ "name": "omg-cloud-ci", "binding": "CI_WORKFLOW", "class_name": "CI" }],
  "r2_buckets": [{ "binding": "BACKUP_BUCKET", "bucket_name": "omg-ci-private" }],
  "vars": {
    "CI_VERIFIER_REVISION": "57ba566934b7f97ba477fafe3feb4ddad58a2ab9",
    "CI_IMAGE_DIGEST": "sha256:4be14b97d737a2a0ed3b6df9cd34e38623bbd9bd8f2f95d4287e1a9be9253d35",
    "BACKUP_BUCKET_NAME": "omg-ci-private",
    "CLOUDFLARE_ACCOUNT_ID": "f1e95b3e1b502cf366dfc81a863695fa",
    "SENTRY_ORG_SLUG": "pyro112189",
    "SENTRY_PROJECT_SLUG": "omg-application",
    "SENTRY_PROJECT_ID": "4512291389636608",
    "SENTRY_ENVIRONMENT": "production",
  },
  "observability": { "enabled": false },
}
