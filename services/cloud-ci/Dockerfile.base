FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS node-runtime
FROM rust:1.95.0-slim-bookworm@sha256:6f9e63259f12e1e599296f5ecfed2bae46de4af0ee0525dd8b89c046e236d5c5 AS rust-runtime
RUN rustup component add rustfmt clippy --toolchain 1.95.0
FROM docker.io/cloudflare/sandbox:0.12.14@sha256:b8175e89ae5efd83987ffd5056f57c28c390fd5706d42ef70fb669e275248e7b
USER root
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=rust-runtime /usr/local/cargo /usr/local/cargo
COPY --from=rust-runtime /usr/local/rustup /usr/local/rustup
ENV RUSTUP_HOME=/usr/local/rustup
ENV PATH=/opt/omg-python/bin:/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
RUN apt-get update && apt-get install -y --no-install-recommends curl unzip ca-certificates git squashfs-tools build-essential pkg-config libssl-dev libarchive-dev clang cmake python3 python3-venv make fish util-linux sudo iproute2 && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -fsSL https://github.com/astral-sh/python-build-standalone/releases/download/20261020/cpython-3.12.15%2B20261020-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz -o /tmp/python.tar.gz && echo '7d6ef1164fb94c4b60d913340610fc7e0ef8e3d1b705aa5628b299b08cbdd4b5  /tmp/python.tar.gz' | sha256sum -c - && mkdir /opt/omg-python && tar -xzf /tmp/python.tar.gz --strip-components=1 -C /opt/omg-python && rm /tmp/python.tar.gz && chmod -R a+rX,go-w /opt/omg-python && python3 -c 'import sys,tomllib,venv,ssl; assert sys.version_info[:3] == (3,12,15); assert ssl.get_default_verify_paths().cafile == "/etc/ssl/certs/ca-certificates.crt"; assert ssl.create_default_context().cert_store_stats()["x509_ca"] > 0' && test -x /usr/bin/sudo
RUN curl -fsSL https://github.com/oven-sh/bun/releases/download/bun-v1.4.4/bun-linux-x64.zip -o /tmp/bun.zip && echo 'bf8ccbfb2b0b80159e0f9a6d15c55317add8077534dbc6130a3edb52fccb395c  /tmp/bun.zip' | sha256sum -c - && unzip -q /tmp/bun.zip -d /tmp/bun-install && echo '10702245766b225e70bbf6235fd6b47214fd94b4760d00ffaed8ab0df57ac235  /tmp/bun-install/bun-linux-x64/bun' | sha256sum -c - && install /tmp/bun-install/bun-linux-x64/bun /usr/local/bin/bun && rm -rf /tmp/bun.zip /tmp/bun-install && test "$(bun --revision)" = '1.4.4+38afee6c8' && test "$(node --version)" = 'v24.22.1' && rustc --version | grep '^rustc 1.95.0 '
RUN curl -fsSL https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-0.9.148/cargo-nextest-0.9.148-x86_64-unknown-linux-musl.tar.gz -o /tmp/nextest.tar.gz && echo 'bf92cb81450872d960ffa13857a83084d557ec0cdc141663d263bb23ef756f97  /tmp/nextest.tar.gz' | sha256sum -c - && tar -xzf /tmp/nextest.tar.gz -C /usr/local/cargo/bin && rm /tmp/nextest.tar.gz && cargo nextest --version
RUN chmod -R a+rX,go-w /usr/local/cargo /usr/local/rustup && setpriv --reuid=10001 --regid=10001 --clear-groups rustc --version | grep '^rustc 1.95.0 ' && setpriv --reuid=10001 --regid=10001 --clear-groups ip -statistics -statistics link > /tmp/ip-statistics && grep -q 'RX:' /tmp/ip-statistics && rm /tmp/ip-statistics
RUN /usr/sbin/groupadd --gid 10001 omg-ci-candidate && /usr/sbin/useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp/omg-portable-home --shell /usr/sbin/nologin omg-ci-candidate && setpriv --reuid=10001 --regid=10001 --clear-groups python3 -c 'import os,pwd,sys,tomllib,venv; assert sys.version_info[:3] == (3,12,15); user = pwd.getpwuid(os.getuid()); assert (user.pw_name,user.pw_uid,user.pw_gid,user.pw_dir,user.pw_shell) == ("omg-ci-candidate",10001,10001,"/tmp/omg-portable-home","/usr/sbin/nologin")'
