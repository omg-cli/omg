{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omg-ci-inspector",
  "account_id": "f1e95b3e1b502cf366dfc81a863695fa",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "MODEL_PACER", "class_name": "ModelPacer", "script_name": "omg-ci-coder" }] },
  "worker_loaders": [{ "binding": "LOADER" }],
  "limits": { "cpu_ms": 1000 },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "destinations": ["latham-openobserve-logs"],
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "destinations": ["latham-openobserve-traces"],
      "persist": true,
      "head_sampling_rate": 1
    }
  },
}
