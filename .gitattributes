# Git Attributes - Configure Git behavior for specific files
# https://git-scm.com/docs/gitattributes

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code
*.rs text diff=rust
*.toml text
*.json text
*.md text
*.txt text
*.yml text
*.yaml text

# Scripts
*.sh text eol=lf
*.bash text eol=lf
*.fish text eol=lf

# Documentation
*.md text diff=markdown
LICENSE text
README text
CHANGELOG text
CONTRIBUTING text
SECURITY text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

# Archives
*.tar binary
*.gz binary
*.zip binary
*.7z binary
*.zst binary

# Compiled binaries
*.so binary
*.dylib binary
*.dll binary
*.exe binary

# Lock files (always LF)
Cargo.lock text eol=lf
package-lock.json text eol=lf

# Git configuration
.gitignore text
.gitattributes text
.gitmodules text

# Linguist vendored paths (exclude from language statistics)
site/* linguist-vendored
target/* linguist-vendored
docs/assets/* linguist-vendored

# Linguist generated files
*.md linguist-documentation
docs/* linguist-documentation

# Export-ignore (files not included in git archive)
.github export-ignore
.editorconfig export-ignore
.gitignore export-ignore
.gitattributes export-ignore
benchmark-hyperfine.sh export-ignore
Makefile export-ignore
