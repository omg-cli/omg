#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd -- "$SCRIPT_DIR/../../../.." && pwd)
TARGET_DIR=${CARGO_TARGET_DIR:-"$HOME/.cache/build-targets/omg-verification"}
OMG_BIN="$TARGET_DIR/debug/omg"
SANDBOX_BASE="$HOME/.cache/omg-verification"
EVIDENCE_BASE="$REPO_ROOT/.pi/verification-evidence/omg"

usage() {
  cat <<'USAGE'
Usage:
  verify-omg build
  OMG_VERIFY_RUN_ID=<id> verify-omg doctor
  OMG_VERIFY_RUN_ID=<id> verify-omg drive <feature-id> -- <omg args...>
  OMG_VERIFY_RUN_ID=<id> verify-omg paths
  OMG_VERIFY_RUN_ID=<id> verify-omg cleanup

Only read-only OMG commands are accepted by `drive`. Evidence is retained under
.pi/verification-evidence/omg/<id>; cleanup removes only disposable run state.
USAGE
}

require_run_id() {
  if [[ -z ${OMG_VERIFY_RUN_ID:-} ]]; then
    echo "error: set OMG_VERIFY_RUN_ID to a unique value" >&2
    exit 2
  fi
  if [[ ! $OMG_VERIFY_RUN_ID =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "error: OMG_VERIFY_RUN_ID may contain only letters, digits, '.', '_' and '-'" >&2
    exit 2
  fi
}

build_input_paths() {
  local input
  for input in src vendor .cargo Cargo.toml Cargo.lock build.rs; do
    [[ ! -e "$REPO_ROOT/$input" ]] || printf '%s\0' "$REPO_ROOT/$input"
  done
}

source_digest() {
  local -a inputs=()
  mapfile -d '' -t inputs < <(build_input_paths)
  find "${inputs[@]}" -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}'
}

build_receipt() {
  local source_sha=${1:-$(source_digest)}
  printf 'version=1\nsource_inputs_sha256=%s\nbinary_sha256=%s\n' \
    "$source_sha" "$(sha256sum "$OMG_BIN" | awk '{print $1}')"
}

require_fresh_binary() {
  if [[ ! -x $OMG_BIN ]]; then
    echo "error: $OMG_BIN does not exist; run 'verify-omg build' first" >&2
    exit 1
  fi
  if find "$REPO_ROOT/src" "$REPO_ROOT/Cargo.toml" "$REPO_ROOT/Cargo.lock" "$REPO_ROOT/vendor" \
    -type f -newer "$OMG_BIN" -print -quit | grep -q .; then
    echo "error: checkout sources are newer than $OMG_BIN; rebuild before driving" >&2
    exit 1
  fi
  if [[ ! -f "$OMG_BIN.source-sha256" ]] || [[ $(cat "$OMG_BIN.source-sha256") != "$(build_receipt)" ]]; then
    echo "error: checkout build inputs or binary do not match the build receipt; rebuild before driving" >&2
    exit 1
  fi
}

sandbox_dir() {
  printf '%s/%s\n' "$SANDBOX_BASE" "$OMG_VERIFY_RUN_ID"
}

evidence_dir() {
  printf '%s/%s\n' "$EVIDENCE_BASE" "$OMG_VERIFY_RUN_ID"
}

prepare_run() {
  require_run_id
  local sandbox evidence
  sandbox=$(sandbox_dir)
  evidence=$(evidence_dir)
  mkdir -p "$sandbox/data" "$sandbox/cache" "$sandbox/config" "$evidence"
}

run_omg() {
  local sandbox
  sandbox=$(sandbox_dir)
  env \
    OMG_DISABLE_TELEMETRY=1 \
    OMG_TELEMETRY=0 \
    OMG_DISABLE_DAEMON=1 \
    OMG_DATA_DIR="$sandbox/data" \
    OMG_CACHE_DIR="$sandbox/cache" \
    OMG_CONFIG_DIR="$sandbox/config" \
    OMG_DAEMON_DATA_DIR="$sandbox/daemon" \
    OMG_SOCKET_PATH="$sandbox/omg.sock" \
    "$OMG_BIN" "$@"
}

host_pacman_db_fingerprint() {
  if [[ ! -d /var/lib/pacman/local ]]; then
    printf 'unavailable\n'
    return
  fi
  find /var/lib/pacman/local -type f -printf '%P:%s:%T@\n' \
    | LC_ALL=C sort \
    | sha256sum \
    | awk '{print $1}'
}

expected_version() {
  awk '
    /^\[package\]$/ { in_package=1; next }
    /^\[/ && in_package { exit }
    in_package && /^version[[:space:]]*=/ {
      value=$0
      sub(/^[^=]*=[[:space:]]*"/, "", value)
      sub(/"[[:space:]]*$/, "", value)
      print value
      exit
    }
  ' "$REPO_ROOT/Cargo.toml"
}

build() {
  mkdir -p "$TARGET_DIR"
  local before after
  before=$(source_digest)
  (
    cd "$REPO_ROOT"
    CARGO_TARGET_DIR="$TARGET_DIR" cargo build -j 2 --locked --bin omg
  )
  after=$(source_digest)
  [[ $before == "$after" ]] || { echo "error: build inputs changed during compilation; rebuild" >&2; return 1; }
  build_receipt "$after" > "$OMG_BIN.source-sha256"
  "$OMG_BIN" --version
}

doctor() {
  prepare_run
  require_fresh_binary

  local expected actual evidence transcript raw status
  expected=$(expected_version)
  actual=$($OMG_BIN --version)
  evidence=$(evidence_dir)
  transcript="$evidence/doctor.txt"
  raw="$(sandbox_dir)/doctor.raw"

  if [[ $actual != "omg $expected" ]]; then
    echo "error: binary version '$actual' does not match Cargo.toml version '$expected'" >&2
    exit 1
  fi

  set +e
  run_omg doctor >"$raw" 2>&1
  status=$?
  set -e

  {
    printf 'source_head: %s\n' "$(git -C "$REPO_ROOT" rev-parse HEAD)"
    printf 'source_inputs_sha256: %s\n' "$(source_digest)"
    printf 'binary_sha256: %s\n' "$(sha256sum "$OMG_BIN" | awk '{print $1}')"
    printf 'binary: %s\n' "$OMG_BIN"
    printf 'version: %s\n' "$actual"
    printf 'sandbox: %s\n' "$(sandbox_dir)"
    printf 'evidence: %s\n' "$evidence"
    printf '%s\n' '--- omg doctor ---'
    cat "$raw"
    printf '%s\n' "--- exit: $status ---"
  } | tee "$transcript"
  rm -f "$raw"
  return "$status"
}

assert_read_only_command() {
  case "$1" in
    search|info|why|outdated|explicit|list|which|status|doctor|size|blame|daemon-status|history|stats)
      ;;
    *)
      echo "error: '$1' is not in the read-only verification allowlist" >&2
      echo "refusing to run package, runtime, config, daemon, project, or filesystem mutations" >&2
      exit 2
      ;;
  esac
}

drive() {
  if [[ $# -lt 3 || $2 != -- ]]; then
    echo "error: usage: verify-omg drive <feature-id> -- <omg args...>" >&2
    exit 2
  fi

  local feature=$1
  shift 2
  assert_read_only_command "$1"
  prepare_run
  require_fresh_binary

  local evidence transcript raw status stamp db_before db_after
  evidence=$(evidence_dir)
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  transcript="$evidence/${stamp}-${feature}.txt"
  raw="$(sandbox_dir)/drive.raw"
  db_before=$(host_pacman_db_fingerprint)

  set +e
  run_omg "$@" >"$raw" 2>&1
  status=$?
  set -e
  db_after=$(host_pacman_db_fingerprint)

  {
    printf 'feature: %s\n' "$feature"
    printf 'source_head: %s\n' "$(git -C "$REPO_ROOT" rev-parse HEAD)"
    printf 'source_inputs_sha256: %s\n' "$(source_digest)"
    printf 'binary_sha256: %s\n' "$(sha256sum "$OMG_BIN" | awk '{print $1}')"
    printf 'command:'
    printf ' %q' "$OMG_BIN" "$@"
    printf '\n'
    printf 'sandbox: %s\n' "$(sandbox_dir)"
    printf 'host_pacman_db_before: %s\n' "$db_before"
    printf 'host_pacman_db_after: %s\n' "$db_after"
    printf '%s\n' '--- stdout+stderr ---'
    cat "$raw"
    printf '%s\n' "--- exit: $status ---"
  } | tee "$transcript"
  rm -f "$raw"
  if [[ $db_before != "$db_after" ]]; then
    echo "error: host pacman database changed while driving a read-only command" >&2
    return 1
  fi
  return "$status"
}

show_paths() {
  prepare_run
  printf 'binary=%s\n' "$OMG_BIN"
  printf 'sandbox=%s\n' "$(sandbox_dir)"
  printf 'evidence=%s\n' "$(evidence_dir)"
}

cleanup() {
  require_run_id
  local sandbox evidence
  sandbox=$(sandbox_dir)
  evidence=$(evidence_dir)
  rm -rf -- "$sandbox"
  printf 'removed sandbox: %s\n' "$sandbox"
  printf 'retained evidence: %s\n' "$evidence"
}

case ${1:-} in
  --help|-h|help)
    usage
    ;;
  build)
    shift
    [[ $# -eq 0 ]] || { usage >&2; exit 2; }
    build
    ;;
  doctor)
    shift
    [[ $# -eq 0 ]] || { usage >&2; exit 2; }
    doctor
    ;;
  drive)
    shift
    drive "$@"
    ;;
  paths)
    shift
    [[ $# -eq 0 ]] || { usage >&2; exit 2; }
    show_paths
    ;;
  cleanup)
    shift
    [[ $# -eq 0 ]] || { usage >&2; exit 2; }
    cleanup
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
